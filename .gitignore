# macOS
.DS_Store

# Build output (generated)
**/build/**
**/build_lite/**
**/build_gru_test/**

# Common embedded outputs
*.o
*.a
*.d
*.lst
*.map
*.elf
*.hex
*.bin

# PlatformIO
.pio/

# Derived audio and scratch from the analysis tools.
daisy_neural/quant_study/
daisy_neural/amp_compare/

# Natively-compiled host harness — machine-specific, built on demand
**/tools/a2_host
**/tools/a2_host_steer
**/tools/a2_explore_s*
**/tools/a2_notamp
**/tools/gru_host
**/tools/gru_host_exact
# The Wasp GRUs' weights, compiled in for the GRU test build. Generated by
# tools/gru_to_header.py; not published until David decides to share the captures.
daisy_neural/nam/gru_test_nets.h

# Python
__pycache__/
*.pyc
daisy_neural/random_weights/

# NAM captures are never committed: they are their creators' work, licensed one by
# one. daisy_neural builds without them; release assets carry the CC0/CC BY starter
# set, credited in daisy_neural/STARTER_CAPTURES.md.
daisy_neural/nam/model_data_nam_a2.h
daisy_neural/captures/
*.nam
*.a2nb

# Python environment for the host analysis tools (see daisy_neural/requirements.txt)
.venv/
.venv-clap/
.venv-nam/

# Editor settings (local to each machine)
.vscode/
