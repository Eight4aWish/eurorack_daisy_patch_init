# macOS
.DS_Store

# Build output (generated)
**/build/**

# Common embedded outputs
*.o
*.a
*.d
*.lst
*.map
*.elf
*.hex
*.bin

# PlatformIO
.pio/

# Derived audio and scratch from the analysis tools. Regenerate with
# tools/quantisation_study.py and tools/compare_captures.py.
daisy_neural/quant_study/
daisy_neural/amp_compare/

# Natively-compiled host harness — machine-specific, built on demand
**/tools/a2_host
**/tools/a2_host_steer
**/tools/a2_explore_s*
**/tools/a2_notamp

# Python
__pycache__/
*.pyc
daisy_neural/random_weights/

# Third-party NAM captures. TONE3000's T3K licence forbids uploading or
# redistributing them without each author's permission, so they live on the
# working machine only — never in this public repo, and not in a private one
# either. daisy_neural builds without them. See daisy_neural/README.md,
# "Note on the captures".
daisy_neural/nam/model_data_nam_a2.h
daisy_neural/captures/
*.nam
*.a2nb

# Python environment for the host analysis tools (see daisy_neural/requirements.txt)
.venv/
.venv-clap/
